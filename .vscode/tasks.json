{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Auto-save and deploy to GitHub/Vercel",
      "type": "process",
      "command": "node",
      "args": ["scripts/auto-sync.mjs"],
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "Manual deploy to Vercel (prebuilt)",
      "type": "process",
      "command": "npm",
      "args": ["run", "deploy:vercel"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    }
  ]
}
